# Dependencies
node_modules/
apps/*/node_modules/

# Re.Pack / Rspack build output
apps/*/build/
apps/*/cdn/
cdn-root/

# Signing keys. The private key signs every production chunk and must never be committed:
# this directory is ignored before `node tools/gen-signing-keys.mjs` is ever run.
code-signing/

# iOS
apps/*/ios/Pods/
apps/*/ios/build/
apps/*/ios/*.xcworkspace/xcuserdata/
apps/*/ios/.xcode.env.local
apps/*/vendor/

# Android
apps/*/android/.gradle/
apps/*/android/app/build/
apps/*/android/build/
apps/*/android/.cxx/
apps/*/android/local.properties

# Metro / Re.Pack cache
.metro-health-check*
**/.cxx/

# Misc
.DS_Store
*.log

{
  "name": "@pokedex/detail",
  "version": "4.0.10",
  "description": "The Pok\u00e9mon detail view as a versioned component: presentational, data in as props, writes out as optional callbacks. Both tab remotes install it and feed it from their own containers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:a11y": "jest --testPathPattern accessibility --reporters=default --reporters=@pokedex/a11y-testing/reporter.js"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "peerDependencies": {
    "@pokedex/contracts": ">=3.2",
    "@pokedex/ui": "^1",
    "nativewind": ">=4.1.23",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=4",
    "react-native-safe-area-context": ">=5"
  },
  "devDependencies": {
    "@pokedex/a11y-testing": "^1.0.18",
    "@pokedex/contracts": "^3.2.1",
    "@pokedex/ui": "^1.0.11",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "react-native": "src/index.ts",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}

{
  "name": "@pokedex/detail",
  "version": "3.1.0",
  "description": "The Pokémon detail view as a versioned component: presentational, data in as props, writes out as optional callbacks. Both tab remotes install it and feed it from their own containers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "peerDependencies": {
    "@pokedex/contracts": ">=3",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": ">=5"
  },
  "devDependencies": {
    "@pokedex/contracts": "^3.0.0",
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.5.2",
    "typescript": "^5.8.3"
  }
}

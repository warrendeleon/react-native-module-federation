{
  "name": "@pokedex/ui",
  "version": "1.0.5",
  "description": "The Pokédex design system: gluestack-ui copy-in primitives, the colour tokens and the eleven composed components (ScreenContainer, PokemonCard, TypeBadge, LoadingState, ErrorState, InfoRow, StatBar, EmptySlot, BackPill, ThemeToggle, Toaster), shared across the federation as a host-provided singleton.",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib",
    "tailwind.preset.js",
    "global.css",
    "README.md",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:a11y": "jest --testPathPattern accessibility --reporters=default --reporters=@pokedex/a11y-testing/reporter.js"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "peerDependencies": {
    "@gluestack-ui/core": ">=3.0.10 <4",
    "@gluestack-ui/utils": ">=3.0.11 <4",
    "nativewind": ">=4.1.23",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=4",
    "react-native-safe-area-context": ">=5",
    "tailwindcss": ">=3.4 <4"
  },
  "devDependencies": {
    "@gluestack-ui/core": "^3.0.21",
    "@gluestack-ui/utils": "^3.0.21",
    "@pokedex/a11y-testing": "^1.0.8",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@expo/html-elements": "^57.0.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}

{
  "name": "@pokedex/a11y-testing",
  "version": "1.0.18",
  "description": "The shared accessibility bar for the federation: a Jest preset that renders NativeWind classes to real styles, WCAG assertion helpers for contrast, touch targets, screen-reader state and non-colour cues, and a reporter that turns a suite run into one accessibility report. Installed as a devDependency by the packages and remotes that run suites against it, so independently shipped teams cannot drift on what accessible means.",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib",
    "jest-preset.js",
    "wcag-criteria.js",
    "reporter.js",
    "README.md",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "peerDependencies": {
    "@react-native/jest-preset": ">=0.85",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/react-native": ">=13.3.3 <14",
    "nativewind": "^4.2.6",
    "react": "*",
    "react-native": "*",
    "react-native-css-interop": "^0.2.6",
    "tailwindcss": ">=3.4 <4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-css-interop": "^0.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
